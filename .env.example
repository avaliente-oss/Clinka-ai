# Conexión PostgreSQL (Prisma Postgres, Neon o cualquier Postgres).
# En Vercel la añade automáticamente la integración de Storage.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/clinika?sslmode=require"

# IA (opcional): sin ninguna clave, las funciones de IA usan respuestas simuladas.
# Si hay ambas claves se usa Anthropic, salvo que AI_PROVIDER indique otra cosa.
AI_PROVIDER=""            # "anthropic" | "openai" (opcional)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
