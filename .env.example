# Conexión agrupada de Neon usada por la aplicación.
DATABASE_URL="postgresql://usuario:contraseña@host-pooler.neon.tech/clinika?sslmode=require"

# Conexión directa de Neon usada por Prisma para migraciones.
DATABASE_URL_UNPOOLED="postgresql://usuario:contraseña@host.neon.tech/clinika?sslmode=require"

# Opcional: sin esta clave, las funciones de IA usan respuestas demo.
ANTHROPIC_API_KEY=""

# Modelo de Anthropic que utilizarán las funciones de IA.
AI_MODEL="claude-sonnet-5-5"
