generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  professionals Professional[]
  patients      Patient[]
  appointments  Appointment[]
  treatments    Treatment[]
  payments      Payment[]
  reminders     Reminder[]
  prices        PriceItem[]
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  password String
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
}

model Professional {
  id           String         @id @default(cuid())
  name         String
  specialty    String
  color        String
  clinicId     String
  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  notes        ClinicalNote[]
  treatments   Treatment[]
  evolutions   Evolution[]
}

model Patient {
  id           String              @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  email        String?
  birthDate    DateTime
  gender       String
  type         String              @default("DENTAL")
  allergies    String?
  conditions   String?
  clinicId     String
  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  notes        ClinicalNote[]
  odontogram   OdontogramFinding[]
  treatments   Treatment[]
  payments     Payment[]
  files        PatientFile[]
  reminders    Reminder[]
  createdAt    DateTime            @default(now())
}

model Appointment {
  id             String       @id @default(cuid())
  start          DateTime
  duration       Int          @default(30)
  reason         String
  status         String       @default("AGENDADA")
  notes          String?
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  evolutions     Evolution[]
}

model ClinicalNote {
  id             String       @id @default(cuid())
  date           DateTime     @default(now())
  subjective     String
  objective      String
  assessment     String
  plan           String
  diagnoses      String?
  aiGenerated    Boolean      @default(false)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
}

model OdontogramFinding {
  id        String   @id @default(cuid())
  tooth     Int
  surface   String
  condition String
  notes     String?
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([patientId, tooth, surface])
}

model Treatment {
  id                        String       @id @default(cuid())
  title                     String
  diagnosis                 String?
  status                    String       @default("PLANIFICADO")
  startDate                 DateTime     @default(now())
  endDate                   DateTime?
  notes                     String?
  patientId                 String
  patient                   Patient      @relation(fields: [patientId], references: [id])
  clinicId                  String
  clinic                    Clinic       @relation(fields: [clinicId], references: [id])
  responsibleProfessionalId String
  responsibleProfessional   Professional @relation(fields: [responsibleProfessionalId], references: [id])
  evolutions                Evolution[]
  procedures                Procedure[]
  payments                  Payment[]
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model Evolution {
  id                 String       @id @default(cuid())
  date               DateTime     @default(now())
  cumulativeProgress Int
  clinicalNotes      String
  nextSteps          String?
  treatmentId        String
  treatment          Treatment    @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  professionalId     String
  professional       Professional @relation(fields: [professionalId], references: [id])
  appointmentId      String?
  appointment        Appointment? @relation(fields: [appointmentId], references: [id])
  procedures         Procedure[]
  createdAt          DateTime     @default(now())

  @@index([treatmentId, date])
}

model Procedure {
  id          String     @id @default(cuid())
  name        String
  tooth       String?
  surface     String?
  price       Float
  quantity    Int        @default(1)
  status      String     @default("PLANIFICADA")
  treatmentId String
  treatment   Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  evolutionId String?
  evolution   Evolution? @relation(fields: [evolutionId], references: [id], onDelete: SetNull)
  priceItemId String?
  priceItem   PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([treatmentId, status])
}

model Payment {
  id          String     @id @default(cuid())
  amount      Float
  method      String
  reference   String?
  date        DateTime   @default(now())
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id])
  clinicId    String
  clinic      Clinic     @relation(fields: [clinicId], references: [id])
  treatmentId String?
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
}

model Reminder {
  id           String   @id @default(cuid())
  type         String
  scheduledFor DateTime
  message      String
  status       String   @default("PENDIENTE")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
}

model PatientFile {
  id        String   @id @default(cuid())
  name      String
  kind      String
  size      String
  date      DateTime @default(now())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model PriceItem {
  id         String      @id @default(cuid())
  name       String
  category   String
  price      Float
  clinicId   String
  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  procedures Procedure[]
}
