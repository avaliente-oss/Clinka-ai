generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  RECORDATORIO_ENVIADO
  REPROGRAMADA
  ATENDIDA
  NO_ASISTIO
  CANCELADA
}

enum TreatmentStatus {
  PLANIFICADO
  EN_CURSO
  TERMINADO
  SUSPENDIDO
}

enum ProcedureStatus {
  PLANIFICADA
  REALIZADA
}

enum ReminderStatus {
  PENDIENTE
  ENVIADO
  CANCELADO
}

enum ReminderType {
  CONFIRMACION
  RECORDATORIO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum PatientType {
  DENTAL
  MEDICO
}

enum Gender {
  FEMENINO
  MASCULINO
  NO_ESPECIFICADO
}

enum DentalSurface {
  O
  M
  D
  V
  L
  P
  LP @map("L/P")
}

enum OdontogramCondition {
  CARIES
  RESTAURACION
  EXTRACCION
  ENDODONCIA
  CORONA
}

enum BlockRecurrence {
  NONE
  DAILY
  WEEKLY
}

enum SupplyMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  CONSUMO
}

enum DocumentType {
  PRESUPUESTO
  RECETA
  CONSENTIMIENTO
  ESTADO_CUENTA
}

model Clinic {
  id                String             @id @default(cuid())
  name              String
  legalName         String?
  address           String?
  phone             String?
  email             String?
  rfc               String?
  logoUrl           String?
  documentFooter    String?            @db.Text
  users             User[]
  professionals     Professional[]
  patients          Patient[]
  appointments      Appointment[]
  treatments        Treatment[]
  payments          Payment[]
  reminders         Reminder[]
  prices            PriceItem[]
  scheduleBlocks    ScheduleBlock[]
  supplies          Supply[]
  documentTemplates DocumentTemplate[]
  issuedDocuments   IssuedDocument[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String
  password               String
  clinicId               String
  clinic                 Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  clinicalNotesCreated   ClinicalNote[]      @relation("ClinicalNoteCreatedBy")
  clinicalNotesUpdated   ClinicalNote[]      @relation("ClinicalNoteUpdatedBy")
  treatmentsCreated      Treatment[]         @relation("TreatmentCreatedBy")
  treatmentsUpdated      Treatment[]         @relation("TreatmentUpdatedBy")
  evolutionsCreated      Evolution[]         @relation("EvolutionCreatedBy")
  evolutionsUpdated      Evolution[]         @relation("EvolutionUpdatedBy")
  proceduresCreated      Procedure[]         @relation("ProcedureCreatedBy")
  proceduresUpdated      Procedure[]         @relation("ProcedureUpdatedBy")
  findingsCreated        OdontogramFinding[] @relation("FindingCreatedBy")
  findingsUpdated        OdontogramFinding[] @relation("FindingUpdatedBy")
  paymentsCreated        Payment[]           @relation("PaymentCreatedBy")
  paymentsUpdated        Payment[]           @relation("PaymentUpdatedBy")
  scheduleBlocksCreated  ScheduleBlock[]     @relation("ScheduleBlockCreatedBy")
  scheduleBlocksUpdated  ScheduleBlock[]     @relation("ScheduleBlockUpdatedBy")
  supplyMovementsCreated SupplyMovement[]    @relation("SupplyMovementCreatedBy")
  prescriptionsCreated   Prescription[]      @relation("PrescriptionCreatedBy")
  prescriptionsUpdated   Prescription[]      @relation("PrescriptionUpdatedBy")
  issuedDocumentsCreated IssuedDocument[]    @relation("IssuedDocumentCreatedBy")

  @@index([clinicId])
}

model Professional {
  id                  String          @id @default(cuid())
  name                String
  specialty           String
  color               String
  licenseNumber       String?
  specialtyLicense    String?
  university          String?
  clinicId            String
  clinic              Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  notes               ClinicalNote[]
  treatments          Treatment[]
  evolutions          Evolution[]
  performedProcedures Procedure[]     @relation("ProcedurePerformedBy")
  scheduleBlocks      ScheduleBlock[]
  prescriptions       Prescription[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([clinicId])
}

model Patient {
  id              String              @id @default(cuid())
  firstName       String
  lastName        String
  phone           String
  email           String?
  birthDate       DateTime
  gender          Gender
  type            PatientType         @default(DENTAL)
  allergies       String?
  conditions      String?
  clinicId        String
  clinic          Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  notes           ClinicalNote[]
  odontogram      OdontogramFinding[]
  treatments      Treatment[]
  payments        Payment[]
  files           PatientFile[]
  reminders       Reminder[]
  prescriptions   Prescription[]
  issuedDocuments IssuedDocument[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([clinicId])
  @@index([clinicId, deletedAt])
}

model Appointment {
  id             String            @id @default(cuid())
  start          DateTime
  duration       Int               @default(30)
  reason         String
  status         AppointmentStatus @default(AGENDADA)
  notes          String?
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  evolutions     Evolution[]
  reminders      Reminder[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId])
  @@index([clinicId, start])
  @@index([professionalId, start])
}

model ClinicalNote {
  id             String       @id @default(cuid())
  date           DateTime     @default(now())
  subjective     String
  objective      String
  assessment     String
  plan           String
  diagnoses      String?
  aiGenerated    Boolean      @default(false)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?        @relation("ClinicalNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?        @relation("ClinicalNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([patientId, date])
  @@index([professionalId])
  @@index([createdById])
  @@index([updatedById])
}

model OdontogramFinding {
  id          String              @id @default(cuid())
  tooth       Int
  surface     DentalSurface
  condition   OdontogramCondition
  notes       String?
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?               @relation("FindingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?               @relation("FindingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([patientId, tooth, surface])
  @@index([createdById])
  @@index([updatedById])
}

model Treatment {
  id                        String           @id @default(cuid())
  title                     String
  diagnosis                 String?
  status                    TreatmentStatus  @default(PLANIFICADO)
  startDate                 DateTime         @default(now())
  endDate                   DateTime?
  notes                     String?
  patientId                 String
  patient                   Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicId                  String
  clinic                    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  responsibleProfessionalId String
  responsibleProfessional   Professional     @relation(fields: [responsibleProfessionalId], references: [id], onDelete: Restrict)
  evolutions                Evolution[]
  procedures                Procedure[]
  payments                  Payment[]
  issuedDocuments           IssuedDocument[]
  createdById               String?
  createdBy                 User?            @relation("TreatmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById               String?
  updatedBy                 User?            @relation("TreatmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  deletedAt                 DateTime?

  @@index([clinicId, status])
  @@index([patientId])
  @@index([responsibleProfessionalId])
  @@index([createdById])
  @@index([updatedById])
}

model Evolution {
  id                 String       @id @default(cuid())
  date               DateTime     @default(now())
  cumulativeProgress Int
  clinicalNotes      String
  nextSteps          String?
  treatmentId        String
  treatment          Treatment    @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  professionalId     String
  professional       Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  appointmentId      String?
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  procedures         Procedure[]
  createdById        String?
  createdBy          User?        @relation("EvolutionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?        @relation("EvolutionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([treatmentId, date])
  @@index([professionalId])
  @@index([appointmentId])
  @@index([createdById])
  @@index([updatedById])
}

model Procedure {
  id              String           @id @default(cuid())
  name            String
  tooth           String?
  surfaces        DentalSurface[]  @default([])
  price           Decimal          @db.Decimal(12, 2)
  quantity        Int              @default(1)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  status          ProcedureStatus  @default(PLANIFICADA)
  treatmentId     String
  treatment       Treatment        @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  evolutionId     String?
  evolution       Evolution?       @relation(fields: [evolutionId], references: [id], onDelete: SetNull)
  priceItemId     String?
  priceItem       PriceItem?       @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  performedAt     DateTime?
  performedById   String?
  performedBy     Professional?    @relation("ProcedurePerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?            @relation("ProcedureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?            @relation("ProcedureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  supplyMovements SupplyMovement[]

  @@index([treatmentId, status])
  @@index([evolutionId])
  @@index([priceItemId])
  @@index([performedById])
  @@index([createdById])
  @@index([updatedById])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  date        DateTime      @default(now())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  treatmentId String?
  treatment   Treatment?    @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?         @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clinicId, date])
  @@index([patientId])
  @@index([treatmentId])
  @@index([createdById])
  @@index([updatedById])
}

model Reminder {
  id            String         @id @default(cuid())
  type          ReminderType
  scheduledFor  DateTime
  message       String
  status        ReminderStatus @default(PENDIENTE)
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clinicId, scheduledFor, status])
  @@index([patientId])
  @@index([appointmentId])
}

model PatientFile {
  id        String   @id @default(cuid())
  name      String
  kind      String
  size      String
  date      DateTime @default(now())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model PriceItem {
  id         String            @id @default(cuid())
  name       String
  category   String
  price      Decimal           @db.Decimal(12, 2)
  clinicId   String
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  procedures Procedure[]
  supplies   PriceItemSupply[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([clinicId])
}

model ScheduleBlock {
  id              String          @id @default(cuid())
  reason          String
  start           DateTime
  end             DateTime
  recurrence      BlockRecurrence @default(NONE)
  recurrenceUntil DateTime?
  clinicId        String
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  professionalId  String?
  professional    Professional?   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?           @relation("ScheduleBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?           @relation("ScheduleBlockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clinicId, start])
  @@index([professionalId, start])
  @@index([createdById])
  @@index([updatedById])
}

model Supply {
  id         String            @id @default(cuid())
  name       String
  category   String
  unit       String
  sku        String?
  stock      Decimal           @default(0) @db.Decimal(12, 3)
  minStock   Decimal           @default(0) @db.Decimal(12, 3)
  unitCost   Decimal?          @db.Decimal(12, 2)
  active     Boolean           @default(true)
  clinicId   String
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  movements  SupplyMovement[]
  priceItems PriceItemSupply[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  @@index([clinicId])
  @@index([clinicId, deletedAt])
}

model SupplyMovement {
  id             String             @id @default(cuid())
  type           SupplyMovementType
  quantity       Decimal            @db.Decimal(12, 3)
  resultingStock Decimal?           @db.Decimal(12, 3)
  reason         String
  supplyId       String
  supply         Supply             @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  procedureId    String?
  procedure      Procedure?         @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?              @relation("SupplyMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([supplyId, createdAt])
  @@index([procedureId])
  @@index([createdById])
}

model PriceItemSupply {
  id          String    @id @default(cuid())
  quantity    Decimal   @db.Decimal(12, 3)
  priceItemId String
  priceItem   PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Restrict)
  supplyId    String
  supply      Supply    @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([priceItemId, supplyId])
  @@index([priceItemId])
  @@index([supplyId])
}

model DocumentTemplate {
  id              String           @id @default(cuid())
  type            DocumentType
  name            String
  title           String
  body            String           @db.Text
  isDefault       Boolean          @default(false)
  clinicId        String
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  issuedDocuments IssuedDocument[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([clinicId, type])
  @@index([clinicId, deletedAt])
}

model Prescription {
  id              String             @id @default(cuid())
  date            DateTime           @default(now())
  diagnosis       String?
  notes           String?
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professionalId  String
  professional    Professional       @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  items           PrescriptionItem[]
  issuedDocuments IssuedDocument[]
  createdById     String?
  createdBy       User?              @relation("PrescriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?              @relation("PrescriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@index([patientId, date])
  @@index([professionalId])
  @@index([createdById])
  @@index([updatedById])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  medication     String
  dose           String
  frequency      String
  duration       String
  instructions   String?
  order          Int
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
}

model IssuedDocument {
  id             String            @id @default(cuid())
  type           DocumentType
  title          String
  snapshot       Json
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  treatmentId    String?
  treatment      Treatment?        @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  prescriptionId String?
  prescription   Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?             @relation("IssuedDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@index([templateId])
  @@index([treatmentId])
  @@index([prescriptionId])
  @@index([createdById])
}
