generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" // Cambiar a "postgresql" para producción
  url = env("DATABASE_URL") }

model Clinic { id String @id @default(cuid()) name String users User[] professionals Professional[] patients Patient[] appointments Appointment[] treatments TreatmentPlan[] payments Payment[] reminders Reminder[] prices PriceItem[] }
model User { id String @id @default(cuid()) email String @unique name String password String clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) }
model Professional { id String @id @default(cuid()) name String specialty String color String clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) appointments Appointment[] notes ClinicalNote[] }
model Patient { id String @id @default(cuid()) firstName String lastName String phone String email String? birthDate DateTime gender String type String @default("DENTAL") allergies String? conditions String? clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) appointments Appointment[] notes ClinicalNote[] odontogram OdontogramFinding[] treatments TreatmentPlan[] payments Payment[] files PatientFile[] reminders Reminder[] createdAt DateTime @default(now()) }
model Appointment { id String @id @default(cuid()) start DateTime duration Int @default(30) reason String status String @default("AGENDADA") notes String? patientId String patient Patient @relation(fields:[patientId], references:[id]) professionalId String professional Professional @relation(fields:[professionalId], references:[id]) clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) }
model ClinicalNote { id String @id @default(cuid()) date DateTime @default(now()) subjective String objective String assessment String plan String diagnoses String? aiGenerated Boolean @default(false) patientId String patient Patient @relation(fields:[patientId], references:[id]) professionalId String professional Professional @relation(fields:[professionalId], references:[id]) }
model OdontogramFinding { id String @id @default(cuid()) tooth Int surface String condition String notes String? patientId String patient Patient @relation(fields:[patientId], references:[id]) updatedAt DateTime @updatedAt @@unique([patientId,tooth,surface]) }
model TreatmentPlan { id String @id @default(cuid()) title String status String @default("PROPUESTO") total Float patientId String patient Patient @relation(fields:[patientId], references:[id]) clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) items TreatmentItem[] createdAt DateTime @default(now()) }
model TreatmentItem { id String @id @default(cuid()) description String tooth String? phase Int @default(1) quantity Int @default(1) unitPrice Float planId String plan TreatmentPlan @relation(fields:[planId], references:[id], onDelete:Cascade) }
model Payment { id String @id @default(cuid()) amount Float method String reference String? date DateTime @default(now()) patientId String patient Patient @relation(fields:[patientId], references:[id]) clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) }
model Reminder { id String @id @default(cuid()) type String scheduledFor DateTime message String status String @default("PENDIENTE") patientId String patient Patient @relation(fields:[patientId], references:[id]) clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) }
model PatientFile { id String @id @default(cuid()) name String kind String size String date DateTime @default(now()) patientId String patient Patient @relation(fields:[patientId], references:[id]) }
model PriceItem { id String @id @default(cuid()) name String category String price Float clinicId String clinic Clinic @relation(fields:[clinicId], references:[id]) }
